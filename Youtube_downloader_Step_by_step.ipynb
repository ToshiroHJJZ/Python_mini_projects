    "!pip install ffmpeg\n",
"# In order to work this out smoothly on python you need first to get Git, extract the downloaded file in the C:\Git location and the C:\ffmpeg as well. Here are the links for both programs:\n",
    "# https://git-scm.com/downloads/win and https://ffmpeg.org/download.html\n",
    "# After both files are the location described, lets create a PATH for them. Search in Windows for 'Edit the system environment variables', go to 'Enviroment Variables', then on the 'System Variables' 
(or 'User Variables' if you only want them in the user you are using on your Windows machine) find the variable called 'Path', click on edit then New and just type the same file locations 
as follows (order does not matter)\n",
    "# 'C:\Git\bin', 'C:\Git\cmd', 'C:\ffmpeg\bin then make sure you can see both of them on your computer using cmd by checking hteir version ex. git -version \n",
    "# Then you can copy and paste the following program making usre that your url is accurate and file location is accurate as well. Have fun!\n",
    "!pip install youtube_dl\n",
    "!pip install yt-dlp\n",
    "!pip install --upgrade youtube_dl\n",
    "!pip install --upgrade yt-dlp\n",
    "!pip install --upgrade ffmpeg"
   ],
   "id": "6a7f4c40c80f4bb8"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": null,
   "source": [
    "from yt_dlp import YoutubeDL\n",
    "\n",
    "ydl_opts = {\n",
    "    'outtmpl': r'you_path_location%(title)s.%(ext)s',\n",
    "    'format': 'bestvideo+bestaudio/best',\n",
    "    'postprocessors': [{\n",
    "        'key': 'FFmpegVideoConvertor',\n",
    "        'preferedformat': 'mp3',   # Note the spelling here can be either mp3 or pm4\n",
    "    }],\n",
    "}\n",
    "\n",
    "url = 'ur_url'\n",
    "\n",
    "with YoutubeDL(ydl_opts) as ydl:\n",
    "    info_dict = ydl.extract_info(url, download=True)\n",
    "    video_title = info_dict.get('title', None)\n",
    "\n",
    "print(f\"Successfully downloaded a YouTube video: {video_title}\")"
   ],
   "id": "b1764a3ac84dc5bb"
